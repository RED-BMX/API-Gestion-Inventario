    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>API_Gestion_Inventario</RootNamespace>
    <UserSecretsId>f4dc0a96-1117-46fd-9633-8dd8a59e2145</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.30" />
